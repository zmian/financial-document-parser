{
  "name": "financial-document-parser",
  "version": "0.1.0",
  "description": "Classify first, then extract: a starter pipeline for parsing pay stubs and bank statements with LLMs.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "parse": "tsx src/cli.ts",
    "eval": "tsx scripts/eval.ts",
    "samples": "tsx scripts/generate-samples.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18",
    "openai": "^7.56.0",
    "pdf-to-img": "^7.0.2",
    "pdfjs-dist": "^6.4.299",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  }
