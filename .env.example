# Required. Used for classification (Decisions API) and, by default, extraction.
OPENAI_API_KEY=

# Which model fills the schema: "openai" or "anthropic".
EXTRACTION_PROVIDER=openai
OPENAI_EXTRACTION_MODEL=gpt-6.1-sol

# Only needed when EXTRACTION_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_EXTRACTION_MODEL=claude-sonnet-5-5

# Below these, the document goes to a person. Tune them on your own documents.
TYPE_THRESHOLD=0.85
VARIANT_THRESHOLD=0.7
FIELD_THRESHOLD=0.8

PORT=3000
